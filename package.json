{
  "name": "narrative-ai",
  "version": "3.1.0",
  "private": true,
  "description": "NarrativeAI — интерактивные истории с Supabase Auth, PostgreSQL и Storage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "css:build": "tailwindcss -i ./src/input.css -o ./public/dist/output.css --minify",
    "format": "prettier --write \"*.{js,json,md,yml,yaml}\" \"server.js\" \"public/**/*.{js,html,css}\" \"src/**/*.{js,css}\" \".github/**/*.{yml,yaml}\" \"deploy/**/*.{md,yml,yaml}\"",
    "format:check": "prettier --check \"*.{js,json,md,yml,yaml}\" \"server.js\" \"public/**/*.{js,html,css}\" \"src/**/*.{js,css}\" \".github/**/*.{yml,yaml}\" \"deploy/**/*.{md,yml,yaml}\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "prettier": "^3.6.2"
  }
}
