# Скопируйте файл в .env и задайте собственный длинный секрет.
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-long-random-secret

# Заполняйте только при использовании внешнего OpenAI-совместимого API.
# Ключ никогда не передаётся браузеру.
AI_API_KEY=

# Таймаут одного запроса к модели (мс)
AI_TIMEOUT_MS=240000
