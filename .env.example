PORT=3000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Public URL used by Supabase email confirmation links. Keep localhost for local development.
APP_URL=http://localhost:3000

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value private and stable; changing it makes previously saved API tokens unreadable.
APP_ENCRYPTION_KEY=replace_with_64_hex_characters

# Optional legacy fallback for a single server-wide model key.
AI_API_KEY=
AI_TIMEOUT_MS=240000
